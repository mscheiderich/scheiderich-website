# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php83" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# --- Enable Server Side Includes for .html files ---
Options +IncludesNOEXEC
AddType text/html .html
AddOutputFilter INCLUDES .html

# --- Keep include fragments out of search results ---
# NOTE: do NOT use "Require all denied" here. SSI virtual includes are subject to
# access control, so denying the fragments also blocks Apache's own subrequest and
# the include fails with "an error occurred while processing this directive".
<IfModule mod_headers.c>
  <FilesMatch "^(header|footer)\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# --- Block web access to Markdown docs ---
# Second layer behind .gitignore. PROJECT_STATUS.md and claude.md were tracked in
# git and, because the repo IS the docroot, were publicly readable on the live site
# (staff emails, server IP, Apps Script deployment URLs, sheet IDs). They are now
# untracked, but this rule means a stray .md can never be served again.
#
# Directive choice: this stack is EasyApache 4 with ea-php83, which ships Apache
# 2.4, so mod_authz_core's "Require all denied" is correct. The Apache 2.2 form
# ("Order allow,deny" / "Deny from all") is deprecated on 2.4 and only works if
# mod_access_compat is loaded, so it is kept solely as a guarded fallback.
# The IfModule guards matter: an unguarded Require on a server without
# mod_authz_core returns 500 for the whole site, and this file has silently
# reverted before (see the PHP handler note above).
#
# Safe with SSI: this targets .md only. Apache's SSI subrequests fetch
# /includes/*.html, which this rule never matches — unlike a FilesMatch over the
# include fragments, which broke includes earlier in this project.
<FilesMatch "\.md$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    <IfModule mod_access_compat.c>
      Order allow,deny
      Deny from all
    </IfModule>
  </IfModule>
</FilesMatch>

# --- Short URLs for referral partner pages ---
# /refer/mike  ->  /refer/mike-scheiderich.html
#
# These are INTERNAL rewrites, not redirects: the short URL stays in the address
# bar, which is the point — partners save and re-use these links.
#
# Flags:
#   NC  case-insensitive, so /refer/Mike also resolves
#   QSA keeps ?p=partner-code attached to the rewritten request. (A substitution
#       with no query of its own already preserves the query string; QSA is stated
#       explicitly so the intent survives future edits.)
#   L   stop rewriting once matched.
#
# Cannot affect SSI or /includes/: every pattern is anchored to ^refer/ with a
# fixed first name, so Apache's SSI subrequests for /includes/header.html,
# /includes/footer.html and /includes/site-css.html never match and pass through
# untouched. The rewrite targets are .html files, so AddOutputFilter INCLUDES
# still applies to them and SSI processing happens exactly as before.
# No loop is possible: each target (e.g. refer/mike-scheiderich.html) does not
# match the pattern that produced it.
#
# Deliberately NOT a general extensionless-URL rule — that would require updating
# all 30 canonical tags and is a separate decision.
#
# Only mike-scheiderich.html exists today; the other six rewrite to files that are
# not built yet and will 404 until those pages ship.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^refer/mike/?$      refer/mike-scheiderich.html    [NC,QSA,L]
  RewriteRule ^refer/crissy/?$    refer/crissy-shatzel.html      [NC,QSA,L]
  RewriteRule ^refer/iris/?$      refer/iris-salgado.html        [NC,QSA,L]
  RewriteRule ^refer/mark/?$      refer/mark-hill.html           [NC,QSA,L]
  RewriteRule ^refer/scott/?$     refer/scott-kesler.html        [NC,QSA,L]
  RewriteRule ^refer/wendy/?$     refer/wendy-alaniz.html        [NC,QSA,L]
  RewriteRule ^refer/jennifer/?$  refer/jennifer-lawler.html     [NC,QSA,L]
</IfModule>
